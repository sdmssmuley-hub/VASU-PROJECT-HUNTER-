# Copy to .env for local runs. In GitHub Actions, set these as repository
# secrets instead (Settings -> Secrets and variables -> Actions) - never
# commit a real .env file.

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Numeric chat/channel ID that should receive reports
TELEGRAM_CHAT_ID=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
VASU_DB_PATH=data/vasu_hunter.db
